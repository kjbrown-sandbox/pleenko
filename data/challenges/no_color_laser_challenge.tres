[resource]
script = ExtResource("1_data")
id = "no_color_laser_challenge"
display_name = "Laser Storm"
time_limit_seconds = 120.0
failure_hint = "Three bombs wander the board. Land a coin in a bomb's bucket to defuse it before its countdown reaches zero."
