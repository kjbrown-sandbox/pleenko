[resource]
script = ExtResource("1")
type = 10
display_name = "Auto-buy"
description = "+1 auto-buy slot per level.\n\nLock an upgrade to a slot and it buys itself the moment you can afford it. Each board's copy of an upgrade takes its own slot."
